generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RecurrenceType {
  ONCE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentSchedule {
  FULL
  SPLIT
}

model User {
  id           Int      @id @default(autoincrement())
  role         UserRole
  email        String   @unique
  firstName    String
  lastName     String
  subtitle     String?
  isActive Boolean @default(true)

  /// €/hour paid for this teacher's overtime classes. Null = admin hasn't set a rate yet.
  honorariumRate Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleEntries       ScheduleEntry[] @relation("ScheduleTeacher")
  targetedAnnouncements Announcement[]  @relation("AnnouncementTarget")
  authoredAnnouncements Announcement[]  @relation("AnnouncementAuthor")

  groups              Group[]              @relation("GroupTeacher")
  groupChanges        GroupChange[]        @relation("GroupChangeAuthor")
  roomCapacityChanges RoomCapacityChange[] @relation("RoomCapacityChangeAuthor")

  substitutions        GroupSubstitution[] @relation("GroupSubstitute")
  createdSubstitutions GroupSubstitution[] @relation("GroupSubstitutionAuthor")

  @@index([role])
}

model Room {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  color String?
  isActive Boolean @default(true)

  /// max number of children the room fits. Null = not set yet (no limit).
  capacity Int?

  scheduleEntries ScheduleEntry[]
  capacityHistory RoomCapacityChange[]
}

/// one row per capacity change of a room (who, when, from → to)
model RoomCapacityChange {
  id          Int  @id @default(autoincrement())
  oldCapacity Int?
  newCapacity Int?

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  changedById Int?
  changedBy   User? @relation("RoomCapacityChangeAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model Group {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  studentCount Int
  isActive     Boolean @default(true)

  teacherId Int
  teacher   User @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  scheduleEntries ScheduleEntry[]
  history         GroupChange[]
  substitutions   GroupSubstitution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
}

/// temporary substitute teacher for a group (e.g. the regular teacher is sick).
/// Every class of the group between startDate and endDate (inclusive) is taught
/// by the substitute: it shows in their schedule and counts in their worked hours.
model GroupSubstitution {
  id        Int      @id @default(autoincrement())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?

  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  substituteId Int
  substitute   User @relation("GroupSubstitute", fields: [substituteId], references: [id], onDelete: Restrict)

  createdById Int?
  createdBy   User? @relation("GroupSubstitutionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([groupId, startDate])
  @@index([substituteId])
}

enum GroupChangeAction {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
}

/// one row per change of a group. `changes` holds { field: { from, to } }
/// with human-readable values (teacher names, not ids), so the history
/// still reads correctly after a teacher is renamed or deleted.
model GroupChange {
  id      Int               @id @default(autoincrement())
  action  GroupChangeAction
  changes Json

  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  changedById Int?
  changedBy   User? @relation("GroupChangeAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

model ScheduleEntry {
  id         Int            @id @default(autoincrement())
  subject    String
  weekday    Weekday
  startTime  String
  endTime    String
  duration   Decimal        @db.Decimal(4, 2)
  color      String?
  recurrence RecurrenceType
  anchorDate DateTime       @db.Date
  /// last day the class can occur. Null = no end. Set when a group's classes
  /// are moved to a new teacher: the old entry ends, a copy continues.
  endDate    DateTime?      @db.Date

  /// true = this whole recurring class is paid via honorarium, not salary
  isOvertime Boolean @default(false)

  teacherId Int
  teacher   User @relation("ScheduleTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// null only for old classes created before groups existed
  groupId Int?
  group   Group? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  exceptions ScheduleException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, weekday])
  @@index([roomId, weekday])
  @@index([groupId])
}

model ScheduleException {
  id            Int      @id @default(autoincrement())
  cancelledDate DateTime @db.Date

  scheduleEntryId Int
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)

  @@unique([scheduleEntryId, cancelledDate])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  publishedAt DateTime @default(now())

  targetTeacherId Int?
  targetTeacher   User? @relation("AnnouncementTarget", fields: [targetTeacherId], references: [id], onDelete: SetNull)

  authorId Int?
  author   User? @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([targetTeacherId])
}

model Student {
  id              Int             @id @default(autoincrement())
  parentFullName  String
  parentPhone     String
  childFullName   String
  paymentMethod   PaymentMethod
  paymentSchedule PaymentSchedule

  fees     Fee[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fee {
  id     Int      @id @default(autoincrement())
  amount Decimal  @db.Decimal(10, 2)
  date   DateTime @db.Date
  note   String?

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([studentId, date])
}

model Payment {
  id     Int           @id @default(autoincrement())
  amount Decimal       @db.Decimal(10, 2)
  date   DateTime      @db.Date
  method PaymentMethod
  note   String?

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([studentId, date])
}
